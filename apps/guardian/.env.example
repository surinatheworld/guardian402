# apps/guardian — variables this app reads (docs/SPEC.md §3; full list in /.env.example).
# Copy to apps/guardian/.env.local (git-ignored). Testnet keys only.

# `local` (Anvil fork) or `fuji`; selects the addresses file.
NETWORK=local
# Real Fuji C-Chain RPC.
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# Chain the vault runs on (policy and verdictNonce are read here): Fuji, or the local fork.
CHAIN_RPC_URL=http://127.0.0.1:8545
# Anvil fork used for simulation.
FORK_RPC_URL=http://127.0.0.1:8545

# Signs EIP-712 verdicts only; holds no funds.
GUARDIAN_SIGNER_PK=
# Address that receives x402 fees.
PAY_TO=
# x402 facilitator; default Ultravioleta DAO, or a self-hosted one.
FACILITATOR_URL=https://facilitator.ultravioletadao.xyz

# LLM provider for the explainer: `none` (templates only) or `anthropic` (Claude, official SDK).
LLM_PROVIDER=none
# Model id for the chosen provider; empty = claude-opus-5-5 for `anthropic`.
LLM_MODEL=
# API key for the chosen provider.
LLM_API_KEY=

# Enables mocks, /v1/demo/check and the DEMO MODE flag in responses.
DEMO_MODE=true
