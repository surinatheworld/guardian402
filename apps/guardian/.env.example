# apps/guardian — variables this app reads (docs/SPEC.md §3; full list in /.env.example).
# Copy to apps/guardian/.env.local (git-ignored). Testnet keys only.

# `local` (Anvil fork) or `fuji`; selects the addresses file.
NETWORK=local
# Real Fuji C-Chain RPC.
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# Chain the vault runs on (policy and verdictNonce are read here): Fuji, or the local fork.
CHAIN_RPC_URL=http://127.0.0.1:8545
# Anvil fork used for simulation.
FORK_RPC_URL=http://127.0.0.1:8545

# Signs EIP-712 verdicts only; holds no funds.
GUARDIAN_SIGNER_PK=
# Address that receives x402 fees.
PAY_TO=
# x402 facilitator; default Ultravioleta DAO, or a self-hosted one.
FACILITATOR_URL=https://facilitator.ultravioletadao.xyz

# LLM provider for the explainer: `none` (templates only), `anthropic` (Claude, official SDK), `gemini` (REST),
# an OpenAI-compatible preset (`groq`, `openrouter`, `cerebras`, `mistral`, `github-models`, `gemini-openai`;
# they need LLM_MODEL) or `openai-compatible` with LLM_BASE_URL.
LLM_PROVIDER=none
# Model id for the chosen provider; empty = claude-opus-5-5 for `anthropic`, gemini-3.5-flash-lite for `gemini`.
LLM_MODEL=
# API key for the chosen provider.
LLM_API_KEY=
# Base URL for LLM_PROVIDER=openai-compatible.
LLM_BASE_URL=

# Guardian API port, the dashboard origin allowed by CORS, and the SQLite file (relative to the repo root).
GUARDIAN_PORT=4402
DASHBOARD_ORIGIN=http://localhost:3000
GUARDIAN_DB=apps/guardian/data/guardian.db
# Self-hosted facilitator (`pnpm facilitator`): chain it settles on (default CHAIN_RPC_URL) and its port.
FACILITATOR_RPC_URL=
FACILITATOR_PORT=4022
# Where the agent and scripts reach the Guardian.
GUARDIAN_URL=http://127.0.0.1:4402

# Enables mocks, /v1/demo/check and the DEMO MODE flag in responses.
DEMO_MODE=true
