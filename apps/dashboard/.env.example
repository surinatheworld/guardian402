# apps/dashboard — public settings only (they are bundled into the browser). Never put a key here.
# Copy to apps/dashboard/.env.local (git-ignored).

# `fuji` (default) or `local` (reads from the Anvil fork; wallet actions still go to the wallet's network).
NEXT_PUBLIC_NETWORK=fuji
# Leave the three URLs below empty for the public endpoint: the dashboard's own browser uses 127.0.0.1, and a
# browser on another machine (public tunnel) calls the same-origin proxy /api/rpc, /api/guardian and
# /api/agent-control (next.config.ts), which forwards to the services on this host. A value set here is used
# by every browser, so set one only when that service has its own public https URL.
# Chain RPC the dashboard reads from. Empty: Fuji public RPC, or the fork for `local` (proxy from other machines).
NEXT_PUBLIC_RPC_URL=
# Guardian API (`pnpm dev:guardian`). Empty: http://127.0.0.1:4402, or /api/guardian from other machines.
NEXT_PUBLIC_GUARDIAN_URL=
# Agent control API (`pnpm dev:agent`, DEMO only). Empty: http://127.0.0.1:4403, or /api/agent-control.
NEXT_PUBLIC_AGENT_URL=

# --- Server only (never NEXT_PUBLIC_) ---
# SQLite file of the accounts API (/api/auth/*, /api/account/*). Default: apps/dashboard/data/accounts.db.
ACCOUNT_DB=
