# apps/dashboard — public settings only (they are bundled into the browser). Never put a key here.
# Copy to apps/dashboard/.env.local (git-ignored).

# `fuji` (default) or `local` (reads from the Anvil fork; wallet actions still go to the wallet's network).
NEXT_PUBLIC_NETWORK=fuji
# Chain RPC the dashboard reads from. Default: Fuji public RPC, or the fork for `local`.
NEXT_PUBLIC_RPC_URL=
# Guardian API (`pnpm dev:guardian`); its DASHBOARD_ORIGIN must be this dashboard's origin.
NEXT_PUBLIC_GUARDIAN_URL=http://127.0.0.1:4402
# Agent control API (`pnpm dev:agent`, DEMO only). Scenario buttons appear when it answers.
NEXT_PUBLIC_AGENT_URL=http://127.0.0.1:4403
