# apps/dashboard — variables this app reads (docs/SPEC.md §3; full list in /.env.example).
# Copy to apps/dashboard/.env.local (git-ignored). The dashboard has no secrets and no keys:
# the owner signs with a browser wallet. Next.js public variable names are settled in P9.

# `local` (Anvil fork) or `fuji`; selects the addresses file.
NETWORK=fuji
# Fuji C-Chain RPC used to read vault balances, policy and Executed events.
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# Shows the DEMO MODE banner and the scenario buttons.
DEMO_MODE=true
