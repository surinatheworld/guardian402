# apps/agent — variables this app reads (docs/SPEC.md §3; full list in /.env.example).
# Copy to apps/agent/.env.local (git-ignored). Testnet keys only.

# `local` (Anvil fork) or `fuji`; selects the addresses file.
NETWORK=local
# Real Fuji C-Chain RPC.
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# Chain the vault runs on (executeBatch is sent here): Fuji, or the local fork.
CHAIN_RPC_URL=http://127.0.0.1:8545

# Agent session key: calls executeBatch and pays x402 fees; needs a little AVAX and USDC.
AGENT_PK=
# Vault owner key, used only by the S6 kill-switch scenario to pause the vault.
OWNER_PK=

# Enables scripted-attack mode and the local control API on 127.0.0.1.
DEMO_MODE=true

# Guardian API base URL (x402-paid /v1/check and /v1/cosign).
GUARDIAN_URL=http://127.0.0.1:4402
# Port of the local control API (`pnpm dev:agent`), bound to 127.0.0.1.
AGENT_PORT=4403
# Origin allowed by the control API's CORS (the dashboard).
DASHBOARD_ORIGIN=http://localhost:3000
