# contracts/ — variables the Foundry scripts read (docs/SPEC.md §3; full list in /.env.example).
# Copy to contracts/.env.local (git-ignored). Testnet keys only.

# `local` (Anvil fork) or `fuji`; selects which addresses file the deploy script writes.
NETWORK=local
# Real Fuji C-Chain RPC (also the `fuji` rpc_endpoint in foundry.toml).
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# Deploys AgentVault and the mocks.
DEPLOYER_PK=
# Vault owner, used by the seed script.
OWNER_PK=
