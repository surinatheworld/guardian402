# Guardian402 — every environment variable (docs/SPEC.md §3).
# Copy to .env.local (git-ignored) and fill in. Use fresh keys made only for this project,
# funded with Fuji testnet assets only. Never put a mainnet key here.

# --- Network ---------------------------------------------------------------
# `local` (Anvil fork) or `fuji`; selects packages/shared/src/addresses/<network>.json.
NETWORK=local
# Real Fuji C-Chain RPC; swap in a provider URL with a key if the public one rate-limits. The fork is reset from it,
# so it must keep recent state: PublicNode does not ("missing trie node" minutes after a reset), the official RPC does.
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# Chain the vault runs on: Fuji RPC, or http://127.0.0.1:8545 in local mode. Reads only latest state, so PublicNode
# (https://avalanche-fuji-c-chain-rpc.publicnode.com, about twice as fast) works here; remote URLs fall back to the
# other public Fuji endpoints on errors (packages/shared/src/rpc.ts).
CHAIN_RPC_URL=http://127.0.0.1:8545
# Anvil fork the Guardian simulates on (`pnpm fork`).
FORK_RPC_URL=http://127.0.0.1:8545

# --- Keys (testnet only, 0x-prefixed 32-byte hex) ----------------------------
# Deploys the contracts (contracts scripts) and owns the ERC-8004 identity (`pnpm erc8004:fuji`).
DEPLOYER_PK=
# Vault owner, used by the seed script and the demo (the dashboard uses a browser wallet instead).
OWNER_PK=
# Agent session key: calls executeBatch and pays x402 fees; needs a little AVAX and USDC.
AGENT_PK=
# Guardian verdict signer: signs EIP-712 verdicts only and holds no funds.
GUARDIAN_SIGNER_PK=
# Self-hosted facilitator only: pays settlement gas; needs a little AVAX.
FACILITATOR_PK=

# --- x402 -------------------------------------------------------------------
# Address that receives the Guardian's x402 fees.
PAY_TO=
# x402 facilitator; default is Ultravioleta DAO, or point it at a self-hosted one.
FACILITATOR_URL=https://facilitator.ultravioletadao.xyz

# --- Explainer (LLM writes text only; it never decides risk) -----------------
# LLM provider for the explainer: `none` (deterministic templates only), `anthropic` (Claude, official SDK),
# `gemini` (Gemini REST API; free tier is 15 requests/minute, beyond that checks fall back to the templates), an
# OpenAI-compatible preset (`groq`, `openrouter`, `cerebras`, `mistral`, `github-models`, `gemini-openai`; these
# need LLM_MODEL) or `openai-compatible` with LLM_BASE_URL.
LLM_PROVIDER=none
# Model id for the chosen provider; empty = claude-opus-5-5 for `anthropic`, gemini-3.5-flash-lite for `gemini`.
LLM_MODEL=
# API key for the chosen provider (empty when LLM_PROVIDER=none).
LLM_API_KEY=
# Base URL of an OpenAI-compatible API (only for LLM_PROVIDER=openai-compatible), e.g. http://127.0.0.1:11434/v1.
LLM_BASE_URL=
# Optional keys for `pnpm --filter @guardian402/guardian llm:compare` (compares providers on the rule fixtures):
# <PROVIDER>_API_KEY, with `-` as `_` (`gemini` and `gemini-openai` both read GEMINI_API_KEY).
GROQ_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
GITHUB_MODELS_API_KEY=
GEMINI_API_KEY=

# Guardian API port, the dashboard origin allowed by CORS, and the SQLite file (relative to the repo root).
GUARDIAN_PORT=4402
DASHBOARD_ORIGIN=http://localhost:3000
GUARDIAN_DB=apps/guardian/data/guardian.db
# Self-hosted facilitator (`pnpm facilitator`): chain it settles on (default CHAIN_RPC_URL) and its port.
FACILITATOR_RPC_URL=
FACILITATOR_PORT=4022
# Where the agent and scripts reach the Guardian.
GUARDIAN_URL=http://127.0.0.1:4402
# Agent control API (`pnpm dev:agent`), bound to 127.0.0.1, DEMO_MODE only.
AGENT_PORT=4403

# --- Dashboard (apps/dashboard/.env.local; public values, bundled into the browser) ---
# NEXT_PUBLIC_NETWORK=fuji
# Empty = 127.0.0.1 from this host's browser, same-origin proxy /api/rpc, /api/guardian, /api/agent-control
# from other machines (public endpoint). Set one only when that service has its own public URL.
# NEXT_PUBLIC_RPC_URL=
# NEXT_PUBLIC_GUARDIAN_URL=
# NEXT_PUBLIC_AGENT_URL=

# --- Demo -------------------------------------------------------------------
# Enables mocks, scripted attacks, demo endpoints and the DEMO MODE banner.
DEMO_MODE=true

# --- Local tooling (not in SPEC §3) -----------------------------------------
# How `pnpm fork` runs Anvil: `auto` (native if it runs, else Docker), `native` or `docker`.
ANVIL_RUNNER=auto

# --- Guardian API exposure (P13) ---------------------------------------------
# Accepted Host headers, comma-separated host:port; empty = this machine on GUARDIAN_PORT. A public deployment
# behind a proxy lists its own host name here.
ALLOWED_HOSTS=
# Checks allowed to wait for the fork before new ones get 503 (nobody is charged for a 503).
MAX_QUEUED_CHECKS=8

# --- MCP server (bonus B2, `pnpm mcp`) ------------------------------------------
# A second fork for the MCP server when the Guardian API runs too (`FORK_PORT=8546 pnpm fork`).
MCP_FORK_RPC_URL=
# Check history of the MCP server.
GUARDIAN_MCP_DB=apps/guardian/data/guardian-mcp.db
# Port of `pnpm fork` (default 8545).
FORK_PORT=

# --- ERC-8004 identity (bonus B1, `pnpm erc8004:fuji`) ----------------------
# Public base URL of the Guardian API to advertise in the registration file; empty = the GitHub repository.
GUARDIAN_PUBLIC_URL=
