{
  "name": "guardian402",
  "version": "0.0.0",
  "private": true,
  "description": "Transaction firewall and co-signer for AI-agent wallets on Avalanche Fuji",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "fork": "node scripts/fork.mjs",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy:local": "node scripts/contracts.mjs deploy local",
    "seed:local": "node scripts/contracts.mjs seed local",
    "deploy:fuji": "node scripts/contracts.mjs deploy fuji",
    "seed:fuji": "node scripts/contracts.mjs seed fuji",
    "verify:fuji": "node scripts/contracts.mjs verify fuji",
    "handoff:fuji": "node scripts/contracts.mjs handoff fuji",
    "abi": "node scripts/gen-abi.mjs",
    "test:crosscheck": "tsx scripts/gen-verdict-fixture.ts && cd contracts && forge test --match-contract VerdictCrossCheck -vv",
    "redeploy-mocks:fuji": "node scripts/contracts.mjs redeploy-mocks fuji",
    "swap-router:fuji": "node scripts/contracts.mjs swap-router fuji",
    "known-contracts": "node scripts/gen-known-contracts.mjs",
    "dev:guardian": "pnpm --filter @guardian402/guardian dev",
    "facilitator": "pnpm --filter @guardian402/guardian facilitator"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5",
    "tsx": "4.23.15"
  },
  "dependencies": {
    "@guardian402/shared": "workspace:*",
    "viem": "2.57.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
