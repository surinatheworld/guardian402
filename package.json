{
  "name": "guardian402",
  "version": "0.0.0",
  "private": true,
  "description": "Transaction firewall and co-signer for AI-agent wallets on Avalanche Fuji",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "local": "bash run-local.sh start",
    "local:setup": "bash run-local.sh setup",
    "local:stop": "bash run-local.sh stop",
    "local:status": "bash run-local.sh status",
    "fork": "node scripts/fork.mjs",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy:local": "node scripts/contracts.mjs deploy local",
    "seed:local": "node scripts/contracts.mjs seed local",
    "deploy:fuji": "node scripts/contracts.mjs deploy fuji",
    "seed:fuji": "node scripts/contracts.mjs seed fuji",
    "verify:fuji": "node scripts/contracts.mjs verify fuji",
    "handoff:fuji": "node scripts/contracts.mjs handoff fuji",
    "abi": "node scripts/gen-abi.mjs",
    "test:crosscheck": "tsx scripts/gen-verdict-fixture.ts && cd contracts && forge test --match-contract VerdictCrossCheck -vv",
    "redeploy-mocks:fuji": "node scripts/contracts.mjs redeploy-mocks fuji",
    "redeploy-vault:fuji": "node scripts/contracts.mjs redeploy-vault fuji",
    "swap-router:fuji": "node scripts/contracts.mjs swap-router fuji",
    "known-contracts": "node scripts/gen-known-contracts.mjs",
    "dev:guardian": "pnpm --filter @guardian402/guardian dev",
    "facilitator": "pnpm --filter @guardian402/guardian facilitator",
    "agent": "pnpm --filter @guardian402/agent agent",
    "dev:agent": "pnpm --filter @guardian402/agent dev",
    "mine-lookalike": "bash scripts/mine-lookalike.sh",
    "dev:dashboard": "pnpm --filter @guardian402/dashboard dev",
    "eval": "pnpm --filter @guardian402/eval eval",
    "erc8004:fuji": "tsx scripts/erc8004.ts fuji",
    "bench:guardian": "tsx scripts/bench-guardian.ts",
    "mcp": "pnpm --filter @guardian402/guardian-mcp start",
    "mcp:example": "pnpm --filter @guardian402/guardian-mcp example",
    "deploy-factory:fuji": "node scripts/contracts.mjs deploy-factory fuji",
    "mcp:agent": "pnpm --silent --filter @guardian402/guardian-mcp agent",
    "happy-path:fuji": "pnpm --filter @guardian402/guardian-mcp happy-path",
    "local:fuji": "bash run-local.sh fuji"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5",
    "tsx": "4.23.15"
  },
  "dependencies": {
    "@guardian402/shared": "workspace:*",
    "viem": "2.57.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "@wagmi/connectors>@base-org/account": "-",
      "@wagmi/connectors>@coinbase/wallet-sdk": "-",
      "@wagmi/connectors>@gemini-wallet/core": "-",
      "@wagmi/connectors>@metamask/sdk": "-",
      "@wagmi/connectors>@safe-global/safe-apps-provider": "-",
      "@wagmi/connectors>@safe-global/safe-apps-sdk": "-",
      "@wagmi/connectors>@walletconnect/ethereum-provider": "-",
      "@wagmi/connectors>cbw-sdk": "-",
      "@wagmi/connectors>porto": "-",
      "ws@>=8.0.0 <8.21.0": "8.21.3"
    }
  }
}
