# Copy this file to .env.local and fill it in. Never commit .env.local.

# Where the payment happens: fuji (test USDC) or mainnet (real USDC on the C-Chain).
NETWORK=fuji

# The seller: the wallet address that gets paid. Any address you own, such as your Core address.
PAY_TO=

# The buyer: the key from `npm run new-wallet`. A wallet made only for this, holding test USDC.
BUYER_PRIVATE_KEY=

# The facilitator checks each payment and sends it on chain. Two public ones that handle Fuji and the C-Chain:
#   https://facilitator.ultravioletadao.xyz
#   https://facilitator.payai.network
FACILITATOR_URL=https://facilitator.ultravioletadao.xyz

# Price of one request, and the most the buyer agrees to pay for one request, in USDC.
PRICE_USDC=0.001
MAX_PRICE_USDC=0.01

# Only for `npm run facilitator`, your own facilitator: the key of a wallet with a little AVAX for gas.
# FACILITATOR_PRIVATE_KEY=

# Only if you use your own RPC provider.
# RPC_URL=
